/* components/full-player/full-player.wxss - 全屏播放器样�?*/

/* 根容�?*/
.full-player {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

/* 背景 */
.player-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.bg-blur {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
}

/* 主内�?*/
.player-content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 关闭按钮 */
.close-btn {
  position: absolute;
  top: 60rpx;
  right: 40rpx;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
}

/* 封面区域 */
.cover-section {
  margin-top: 120rpx;
  margin-bottom: 60rpx;
}

.cover-container {
  width: 320rpx;
  height: 420rpx;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  overflow: hidden;
  transition: transform 0.3s ease;
}

.cover-container.playing {
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.cover {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-text {
  font-size: 120rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
}

/* 文字信息 */
.info-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.player-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.player-author {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.player-duration {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 进度�?*/
.progress-section {
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
}

.time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  width: 100rpx;
}

.current-time {
  text-align: right;
  padding-right: 20rpx;
}

.total-time {
  text-align: left;
  padding-left: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  position: relative;
}

.progress-fill {
  height: 100%;
  background: #00ff88;
  border-radius: 4rpx;
  transition: width 0.1s linear;
}

.progress-dot {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  background: #00ff88;
  border-radius: 50%;
  box-shadow: 0 0 10rpx rgba(0, 255, 136, 0.5);
}

/* 播放控制 */
.controls-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 50rpx;
}

.control-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.control-btn text {
  font-size: 48rpx;
}

.control-btn.prev,
.control-btn.next {
  width: 100rpx;
  height: 100rpx;
}

.control-btn.play {
  width: 140rpx;
  height: 140rpx;
  background: #00ff88;
  border-radius: 50%;
  margin: 0 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 255, 136, 0.4);
}

.control-btn.play text {
  font-size: 56rpx;
  color: #1a1a2e;
}

.control-btn.play.playing {
  background: rgba(255, 255, 255, 0.2);
}

.control-btn.play.playing text {
  color: #fff;
}

/* 额外操作 */
.extra-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 100rpx;
  margin-bottom: auto;
}

.extra-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.7);
}

.extra-btn text:first-child {
  font-size: 48rpx;
}

.extra-btn.active text:first-child {
  color: #ff6b6b;
}

.btn-label {
  font-size: 22rpx;
}

/* 底部提示 */
.bottom-tip {
  padding: 30rpx 0;
  text-align: center;
}

.bottom-tip .tip-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}
