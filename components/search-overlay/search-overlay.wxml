<!--components/search-overlay/search-overlay.wxml - 搜索覆盖层-->
<view class="search-overlay" wx:if="{{show}}">
  <!-- 搜索头部 -->
  <view class="search-header">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" 
             placeholder="搜索书名/作者/金句" 
             value="{{keyword}}"
             bindinput="onInput"
             bindconfirm="onSearch"
             focus="{{show}}" />
      <text class="clear-btn" wx:if="{{keyword}}" bindtap="onClear">✕</text>
    </view>
    <text class="cancel-btn" bindtap="onCancel">取消</text>
  </view>

  <!-- 搜索类型切换 -->
  <view class="type-bar" wx:if="{{keyword.length > 0}}">
    <view class="type-item {{searchType === 'all' ? 'active' : ''}}" 
          bindtap="onTypeChange" data-type="all">全部</view>
    <view class="type-item {{searchType === 'book' ? 'active' : ''}}" 
          bindtap="onTypeChange" data-type="book">书籍</view>
    <view class="type-item {{searchType === 'quote' ? 'active' : ''}}" 
          bindtap="onTypeChange" data-type="quote">金句</view>
  </view>

  <!-- 搜索历史 -->
  <view class="section" wx:if="{{keyword.length === 0}}">
    <view class="section-header">
      <text class="section-title">搜索历史</text>
      <text class="section-action" bindtap="onClearHistory">清空</text>
    </view>
    <view class="history-tags">
      <view class="tag" wx:for="{{searchHistory}}" wx:key="*this" 
            bindtap="onHistoryTap" data-keyword="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="section" wx:if="{{keyword.length === 0}}">
    <view class="section-header">
      <text class="section-title">热门搜索</text>
    </view>
    <view class="history-tags">
      <view class="tag hot" wx:for="{{hotKeywords}}" wx:key="*this" 
            bindtap="onHistoryTap" data-keyword="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{keyword.length > 0}}">
    <!-- 书籍结果 -->
    <view wx:if="{{searchType === 'all' || searchType === 'book'}}">
      <view class="result-section-title" wx:if="{{bookResults.length > 0}}">书籍</view>
      <view class="book-result" wx:for="{{bookResults}}" wx:key="id" 
            bindtap="onBookTap" data-id="{{item.id}}">
        <view class="result-cover" style="background-color: {{item.color}}">
          <text>{{item.title}}</text>
        </view>
        <view class="result-info">
          <text class="result-title">{{item.title}}</text>
          <text class="result-author">{{item.author}}</text>
          <text class="result-category">{{item.categoryName}}</text>
        </view>
      </view>
    </view>

    <!-- 金句结果 -->
    <view wx:if="{{searchType === 'all' || searchType === 'quote'}}">
      <view class="result-section-title" wx:if="{{quoteResults.length > 0}}">金句</view>
      <view class="quote-result" wx:for="{{quoteResults}}" wx:key="id">
        <text class="quote-type">金句</text>
        <text class="quote-content">{{item.content}}</text>
        <text class="quote-source">—— {{item.author}}《{{item.bookName}}》</text>
      </view>
    </view>

    <!-- 空结果 -->
    <view class="empty-state" wx:if="{{bookResults.length === 0 && quoteResults.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">未找到相关结果</text>
    </view>
  </view>
</view>
