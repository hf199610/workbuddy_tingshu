/* components/search-overlay/search-overlay.wxss - 搜索覆盖层样式 */

.search-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  z-index: 1000;
  overflow-y: auto;
}

/* 搜索头部 */
.search-header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  padding-top: 88rpx;
}

.search-input-wrap {
  flex: 1;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  color: #fff;
  font-size: 26rpx;
}

.clear-btn {
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  padding: 0 8rpx;
}

.cancel-btn {
  color: #fff;
  font-size: 28rpx;
  margin-left: 20rpx;
}

/* 类型切换 */
.type-bar {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.type-item {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
}

.type-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

/* 区块 */
.section {
  padding: 24rpx 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-action {
  font-size: 24rpx;
  color: #999;
}

/* 历史标签 */
.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.tag.hot {
  background: rgba(102, 126, 234, 0.15);
  color: #667eea;
}

/* 搜索结果 */
.search-results {
  padding: 20rpx 30rpx;
}

.result-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 16rpx;
}

/* 书籍结果 */
.book-result {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.result-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.result-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.result-author {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.result-category {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
  width: fit-content;
}

/* 金句结果 */
.quote-result {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.quote-type {
  font-size: 20rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-bottom: 12rpx;
}

.quote-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  display: block;
  margin-bottom: 8rpx;
}

.quote-source {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
