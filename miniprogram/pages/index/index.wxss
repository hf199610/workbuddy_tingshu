/* pages/index/index.wxss - 首页样式（匹配原型设计） */

.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-header {
  background: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-bar {
  background: #f5f5f5;
  border-radius: 40rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.search-icon {
  color: #999;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-text {
  color: #999;
  font-size: 26rpx;
}

/* 区块 */
.section {
  padding: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.more-link {
  font-size: 24rpx;
  color: #ff6b6b;
}

/* 轮播图 */
.swiper-area {
  padding-top: 0;
}

.swiper {
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.swiper-item {
  height: 100%;
  display: flex;
  align-items: flex-end;
  padding: 40rpx;
  background-size: cover;
  background-position: center;
}

.swiper-content {
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.swiper-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
}

.swiper-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 每日金句海报 */
.quote-poster {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  margin: 0 32rpx 32rpx;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.quote-poster::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
}

.quote-poster-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  position: relative;
}

.quote-poster-title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quote-icon {
  font-size: 36rpx;
}

.quote-refresh-btn {
  background: rgba(255,255,255,0.2);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.quote-content-wrap {
  text-align: center;
  padding: 20rpx 0;
}

.quote-content-main {
  font-size: 32rpx;
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
}

.quote-author-main {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

.quote-poster-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 32rpx;
  position: relative;
}

.quote-action-btn {
  background: rgba(255,255,255,0.2);
  color: white;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}

/* 快速入口 */
.quick-entries {
  background: #fff;
  margin: 0 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.entry-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.book-entry {
  background: #fff3e0;
}

.quote-entry {
  background: #e8f5e9;
}

.favorite-entry {
  background: #fce4ec;
}

.history-entry {
  background: #e3f2fd;
}

.entry-label {
  font-size: 24rpx;
  color: #666;
}

/* 最新讲解 */
.book-list-h {
  display: flex;
  gap: 24rpx;
  white-space: nowrap;
}

.book-item-h {
  display: inline-flex;
  flex-direction: column;
  gap: 12rpx;
  width: 200rpx;
}

.book-cover {
  width: 200rpx;
  height: 260rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.cover-text {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
}

.book-name-h {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-duration {
  font-size: 22rpx;
  color: #999;
}

.footer {
  text-align: center;
  padding: 40rpx;
  color: #ccc;
  font-size: 24rpx;
}
