<!--pages/user/user.wxml - 个人中心（匹配原型）-->
<view class="page-container">
  <!-- 用户信息区 -->
  <view class="user-header">
    <view class="user-info-wrap">
      <view class="avatar">👤</view>
      <view class="user-detail">
        <text class="nickname">小鱼儿</text>
        <text class="user-id">ID: 88866688</text>
      </view>
      <text class="user-edit">编辑 ></text>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="data-stats">
    <view class="stat-card">
      <text class="stat-icon">📚</text>
      <view class="stat-info">
        <text class="stat-num">{{favBookCount}}</text>
        <text class="stat-label">收藏书籍</text>
      </view>
    </view>
    <view class="stat-card">
      <text class="stat-icon">💬</text>
      <view class="stat-info">
        <text class="stat-num">{{favQuoteCount}}</text>
        <text class="stat-label">收藏金句</text>
      </view>
    </view>
    <view class="stat-card">
      <text class="stat-icon">🎧</text>
      <view class="stat-info">
        <text class="stat-num">{{listenCount}}</text>
        <text class="stat-label">听书记录</text>
      </view>
    </view>
  </view>

  <!-- 收藏Tab -->
  <view class="fav-tabs">
    <view class="fav-tab {{currentFavTab === 'books' ? 'active' : ''}}" 
          bindtap="onFavTabTap" 
          data-type="books">📚 书本收藏</view>
    <view class="fav-tab {{currentFavTab === 'quotes' ? 'active' : ''}}" 
          bindtap="onFavTabTap" 
          data-type="quotes">💬 金句收藏</view>
  </view>

  <!-- 书本收藏 -->
  <view class="fav-content" wx:if="{{currentFavTab === 'books'}}">
    <view class="fav-book-grid">
      <view class="fav-book-card" 
            wx:for="{{favBooks}}" 
            wx:key="id"
            bindtap="onBookTap"
            data-id="{{item.id}}">
        <view class="fav-book-cover" style="background: {{item.color}}">
          <text class="cover-text">{{item.title}}</text>
        </view>
        <text class="fav-book-title">{{item.title}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{favBooks.length === 0}}">
      <text class="empty-text">暂无收藏书籍</text>
      <view class="go-explore" bindtap="onGoExplore">去探索</view>
    </view>
  </view>

  <!-- 金句收藏 -->
  <view class="fav-content" wx:if="{{currentFavTab === 'quotes'}}">
    <view class="fav-quote-list">
      <view class="fav-quote-item" 
            wx:for="{{favQuotes}}" 
            wx:key="id">
        <text class="fav-quote-text">{{item.content}}</text>
        <view class="fav-quote-meta">
          <text>—— {{item.author}}《{{item.bookName}}》</text>
          <view class="fav-quote-actions">
            <text bindtap="onPlayQuote" data-id="{{item.id}}">▶</text>
            <text bindtap="onCopyQuote" data-content="{{item.content}}">📋</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{favQuotes.length === 0}}">
      <text class="empty-text">暂无收藏金句</text>
    </view>
  </view>

  <!-- 最近播放 -->
  <view class="section-header-card" style="margin-top:20rpx">
    <text class="section-title">最近播放</text>
  </view>
  <view class="history-list">
    <view class="history-item" 
          wx:for="{{histories}}" 
          wx:key="id"
          bindtap="onHistoryTap"
          data-id="{{item.id}}">
      <view class="history-cover" style="background: {{item.color}}">
        <text class="cover-text">{{item.title[0]}}</text>
      </view>
      <view class="history-info">
        <text class="history-title">{{item.title}}</text>
        <text class="history-author">{{item.author}}</text>
      </view>
      <view class="history-progress">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.progress || 0}}%"></view>
        </view>
        <text class="progress-text">已听 {{item.progress || 0}}%</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{histories.length === 0}}">
      <text class="empty-text">暂无播放记录</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-card" style="margin-top:32rpx">
    <view class="menu-item" bindtap="onMenuTap" data-type="about">
      <view class="menu-left">
        <text class="menu-icon-text">ℹ️</text>
        <text class="menu-text">关于我们</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-type="privacy">
      <view class="menu-left">
        <text class="menu-icon-text">🔒</text>
        <text class="menu-text">隐私政策</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-type="feedback">
      <view class="menu-left">
        <text class="menu-icon-text">💬</text>
        <text class="menu-text">意见反馈</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer">
    <text>听书 · 让阅读更简单</text>
  </view>
</view>

<!-- 迷你播放器 -->
<mini-player 
  id="miniPlayer"
  show="{{showMiniPlayer}}"
  title="{{playerState.title}}"
  subtitle="{{playerState.subtitle}}"
  coverColor="{{playerState.coverColor}}"
  isPlaying="{{playerState.isPlaying}}"
  bind:openplayer="onOpenPlayer"
/>
