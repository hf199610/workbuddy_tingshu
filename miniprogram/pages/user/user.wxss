/* pages/user/user.wxss - 个人中心样式（匹配原型） */

.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 用户信息区 */
.user-header {
  position: relative;
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-info-wrap {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 52rpx;
  flex-shrink: 0;
}

.user-detail {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
}

.user-id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.user-edit {
  color: #ff6b6b;
  font-size: 26rpx;
}

/* 数据统计 */
.data-stats {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 20rpx;
}

.stat-icon {
  font-size: 40rpx;
}

.stat-info {
  flex: 1;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 收藏Tab */
.fav-tabs {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.fav-tab {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 20rpx;
}

.fav-tab.active {
  background: #ff6b6b;
  color: #fff;
  font-weight: 600;
}

/* 收藏内容 */
.fav-content {
  padding: 24rpx 32rpx;
}

/* 书本收藏网格 */
.fav-book-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.fav-book-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fav-book-cover {
  width: 100%;
  aspect-ratio: 3/4;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.cover-text {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.fav-book-title {
  font-size: 24rpx;
  color: #333;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  text-align: center;
}

/* 金句收藏列表 */
.fav-quote-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fav-quote-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.fav-quote-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
}

.fav-quote-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fav-quote-actions {
  display: flex;
  gap: 24rpx;
}

.fav-quote-action {
  font-size: 28rpx;
  opacity: 0.6;
}

/* 区块标题 */
.section-header-card {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

/* 最近播放列表 */
.history-list {
  padding: 0 32rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.history-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.history-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.history-author {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.history-progress {
  width: 120rpx;
  margin-left: 12rpx;
  text-align: right;
  flex-shrink: 0;
}

.progress-bar {
  height: 6rpx;
  background: #f0f0f0;
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.progress-fill {
  height: 100%;
  background: #ff6b6b;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #ff6b6b;
  font-weight: 500;
}

/* 菜单卡片 */
.menu-card {
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-text {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 24rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
}

.go-explore {
  margin: 0 auto;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: 32rpx;
  background: transparent;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx;
  color: #ccc;
  font-size: 24rpx;
}
