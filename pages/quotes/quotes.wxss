/* pages/quotes/quotes.wxss - 金句列表样式（匹配原型） */

.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-header {
  background: #fff;
  padding: 16rpx 32rpx;
  border-bottom:1rpx solid #f0f0f0;
}

.search-bar {
  background: #f5f5f5;
  border-radius: 40rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding:0 32rpx;
}

.search-icon {
  color: #999;
  font-size:28rpx;
  margin-right:16rpx;
}

.search-text {
  color: #999;
  font-size:26rpx;
}

/* 筛选栏 */
.filter-section {
  margin:20rpx 32rpx;
}

.filter-scroll {
  white-space: nowrap;
  overflow-x: auto;
}

.filter-list {
  display: inline-flex;
  gap:16rpx;
}

.filter-item {
  display: inline-block;
  padding:12rpx 32rpx;
  background: #fff;
  border-radius:30rpx;
  font-size:26rpx;
  color: #666;
}

.filter-item.active {
  background: #ff6b6b;
  color: #fff;
  font-weight:600;
}

/* 工具栏 */
.list-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding:20rpx 32rpx;
  font-size:26rpx;
  color: #999;
}

.quote-count {
  font-size:26rpx;
  color: #999;
}

/* 金句列表 */
.quotes-waterfall {
  display: flex;
  flex-direction: column;
  gap:20rpx;
  padding:0 32rpx 32rpx;
}

.quote-card {
  background: #fff;
  border-radius:24rpx;
  padding:32rpx;
  box-shadow:0 4rpx 16rpx rgba(0,0,0,0.05);
}

.quote-content-text {
  font-size:30rpx;
  line-height:1.7;
  color: #333;
  display: block;
}

.quote-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top:24rpx;
  border-top:1rpx solid #f5f5f5;
  margin-top:24rpx;
}

.author-info {
  display: flex;
  align-items: center;
  gap:12rpx;
}

.author-name {
  font-size:26rpx;
  color: #666;
  font-weight:500;
}

.book-name-q {
  font-size:24rpx;
  color: #999;
}

.action-icons {
  display: flex;
  gap:24rpx;
}

.icon-action {
  display: flex;
  align-items: center;
  gap:8rpx;
  font-size:22rpx;
  color: #999;
}

.icon-play {
  font-size:28rpx;
}

.play-count {
  font-size:22rpx;
}

.icon-copy {
  font-size:28rpx;
}

.icon-fav {
  font-size:28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding:100rpx 0;
}

.empty-icon {
  font-size:80rpx;
  margin-bottom:20rpx;
}

.empty-text {
  font-size:28rpx;
  color: #999;
}
